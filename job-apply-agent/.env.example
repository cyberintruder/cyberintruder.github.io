# ---- Claude (required for matching, tailoring, screenshot reading, form answering) ----
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model used for every LLM call
JOBAPPLY_MODEL=claude-opus-5

# ---- Paths ----
JOBAPPLY_DATA_DIR=./data
JOBAPPLY_CONFIG=./config/config.yaml
JOBAPPLY_ANSWERS=./config/answers.yaml
JOBAPPLY_RESUME_DIR=./resumes

# ---- Safety switches ----
# dry_run: do everything except the final Submit click / email send
JOBAPPLY_DRY_RUN=true
# require_review: any required question the agent cannot answer confidently
# parks the application in the review queue instead of guessing
JOBAPPLY_REQUIRE_REVIEW=true
# email_mode: draft | send   (draft creates a Gmail draft and stops)
JOBAPPLY_EMAIL_MODE=draft

# ---- Web UI ----
JOBAPPLY_WEB_HOST=127.0.0.1
JOBAPPLY_WEB_PORT=8000

# ---- Gmail OAuth (see docs/gmail.md) ----
JOBAPPLY_GMAIL_CREDENTIALS=./secrets/credentials.json
JOBAPPLY_GMAIL_TOKEN=./secrets/token.json
